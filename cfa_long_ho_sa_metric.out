INPUT INSTRUCTIONS

  TITLE: Longitudinal CFA, scale-level metric invariance, all factors correlated,
         NO correlated uniquenesses
  DATA:   FILE = application_example.dat;
  VARIABLE:
      names = ID HO11-HO14 HO21-HO24 HO31-HO34
                 SA11-SA18 SA21-SA28 SA31-SA38;
      USEVARIABLES = HO11-HO14 HO21-HO24 HO31-HO34
                 SA12 SA14 SA15-SA16
                 SA22 SA24 SA25-SA26
                 SA32 SA34 SA35-SA36;
  ANALYSIS:
      ESTIMATOR = ML;

  MODEL:
      HO1 BY HO11
             HO12 (LX12)
             HO13 (LX13)
             HO14 (LX14);
      HO2 BY HO21
             HO22 (LX22)
             HO23 (LX23)
             HO24 (LX24);
      HO3 BY HO31
             HO32 (LX32)
             HO33 (LX33)
             HO34 (LX34);
      SA1 BY SA12
             SA14 (LY12)
             SA15 (LY13)
             SA16 (LY14);
      SA2 BY SA22
             SA24 (LY22)
             SA25 (LY23)
             SA26 (LY24);
      SA3 BY SA32
             SA34 (LY32)
             SA35 (LY33)
             SA36 (LY34);
      ! Intercepts: marker item fixed at 0 each wave; others labeled
      [HO11] (IX11); [HO12] (IX12); [HO13] (IX13); [HO14] (IX14);
      [HO21] (IX11); [HO22] (IX22); [HO23] (IX23); [HO24] (IX24);
      [HO31] (IX11); [HO32] (IX32); [HO33] (IX33); [HO34] (IX34);

      [SA12] (IY11); [SA14] (IY12); [SA15] (IY13); [SA16] (IY14);
      [SA22] (IY11); [SA24] (IY22); [SA25] (IY23); [SA26] (IY24);
      [SA32] (IY11); [SA34] (IY32); [SA35] (IY33); [SA36] (IY34);

      ! Latent means freely estimated at all waves (identified by marker intercept = 0)
      [HO1@0]; [SA1@0];
      [HO2* HO3*];
      [SA2* SA3*];

  MODEL CONSTRAINT:
      ! Scale-level (sum-of-loadings) metric invariance
      0 = LX12 + LX13 + LX14 - LX22 - LX23 - LX24;
      0 = LX12 + LX13 + LX14 - LX32 - LX33 - LX34;
      0 = LY12 + LY13 + LY14 - LY22 - LY23 - LY24;
      0 = LY12 + LY13 + LY14 - LY32 - LY33 - LY34;

  OUTPUT: STDYX;



