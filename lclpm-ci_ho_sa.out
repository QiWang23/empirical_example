Mplus VERSION 8.10
MUTHEN & MUTHEN
06/29/2026   4:28 AM

INPUT INSTRUCTIONS

  DATA:   FILE = application_example.dat;
  DEFINE:
      cx1 = SUM(HO11 HO12 HO13 HO14);
      cx2 = SUM(HO21 HO22 HO23 HO24);
      cx3 = SUM(HO31 HO32 HO33 HO34);
      cy1 = SUM(SA12 SA14 SA15 SA16);
      cy2 = SUM(SA22 SA24 SA25 SA26);
      cy3 = SUM(SA32 SA34 SA35 SA36);
      VARIABLE:
          names = ID HO11-HO14
                     HO21-HO24
                     HO31-HO34
                     SA11-SA18
                     SA21-SA28
                     SA31-SA38;

      USEVARIABLES = cx1 cx2 cx3 cy1 cy2 cy3;
      ANALYSIS:
          ESTIMATOR = ML;
          MODEL = NOCOV;

      MODEL:
          FX1 BY cx1@1;
          FX2 BY cx2@1;
          FX3 BY cx3@1;
          FY1 BY cy1@1;
          FY2 BY cy2@1;
          FY3 BY cy3@1;
          cx1@3.228441;
          cx2@3.112889;
          cx3@3.429189;
          cy1@4.920829;
          cy2@4.69457;
          cy3@4.64167;
          RIX BY FX1@1 FX2@1 FX3@1;
          RIY BY FY1@1 FY2@1 FY3@1;
          FX1@0;
          FY1@0;
          FX2@0;
          FY2@0;
          FX3@0;
          FY3@0;
          RIX WITH RIY;
          WFX1 BY FX1@1;
          WFY1 BY FY1@1;
          WFX2 BY FX2@1;
          WFY2 BY FY2@1;
          WFX3 BY FX3@1;
          WFY3 BY FY3@1;
          ! -------- Structural paths --------
          ! Wave 2
          WFX2 ON WFX1;
          WFX2 ON WFY1;
          WFY2 ON WFX1;
          WFY2 ON WFY1;

          ! Wave 3
          WFX3 ON WFX2;
          WFX3 ON WFY2;
          WFY3 ON WFX2;
          WFY3 ON WFY2;

          WFX1 with WFY1;
          WFX2 with WFY2;
          WFX3 with WFY3;


  output: TECH1 TECH3 STDYX SAMPSTAT CINTERVAL;



