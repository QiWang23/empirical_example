Mplus VERSION 8.10
MUTHEN & MUTHEN
06/30/2026  12:30 AM

INPUT INSTRUCTIONS

  DATA:   FILE = application_example.dat;
    VARIABLE:
        names = ID HO11-HO14
                   HO21-HO24
                   HO31-HO34
                   SA11-SA18
                   SA21-SA28
                   SA31-SA38;

      USEVARIABLES = HO11-HO14
                   HO21-HO24
                   HO31-HO34
                   SA12 SA14 SA15-SA16
                   SA22 SA24 SA25-SA26
                   SA32 SA34 SA35-SA36;

    analysis:
    estimator = ml;
    MODEL = NOCOV;


  MODEL:
      HO1 BY HO11
             HO12 (LX12)
             HO13 (LX13)
             HO14 (LX14);

      HO2 BY HO21
             HO22 (LX22)
             HO23 (LX23)
             HO24 (LX24);

      HO3 BY HO31
             HO32 (LX32)
             HO33 (LX33)
             HO34 (LX34);

      SA1 BY SA12
             SA14(LY12)
             SA15(LY13)
             SA16(LY14);
      SA2 BY SA22
             SA24(LY22)
             SA25(LY23)
             SA26(LY24);
      SA3 BY SA32
             SA34(LY32)
             SA35(LY33)
             SA36(LY34);

      ! Create between components (random intercepts)
      RIx BY HO1@1 HO2@1 HO3@1;
      RIy BY SA1@1 SA2@1 SA3@1;

      ! Estimate covariance between random intercepts
      RIx with RIy;

      wx1 by HO1@1;
      wx2 by HO2@1;
      wx3 by HO3@1;

      wy1 by SA1@1;
      wy2 by SA2@1;
      wy3 by SA3@1;

      ! Constrain measurement error variances to 0
      HO1-SA3@0;

      ! Estimate lagged effects between within-person centered variables
      wx2 wy2 on wx1 wy1;
      wx3 wy3 on wx2 wy2;

      ! Estimate covariance between within-person components at first wave
      wx1 WITH wy1;

      ! Estimate covariances between residuals of within-person components
      ! (i.e., innovations)
      wx2 WITH wy2;
      wx3 WITH wy3;

      ! Intercepts: marker item fixed at 0 each wave; others labeled
      [HO11] (IX11); [HO12] (IX12); [HO13] (IX13); [HO14] (IX14);
      [HO21] (IX11); [HO22] (IX22); [HO23] (IX23); [HO24] (IX24);
      [HO31] (IX11); [HO32] (IX32); [HO33] (IX33); [HO34] (IX34);

      [SA12] (IY11); [SA14] (IY12); [SA15] (IY13); [SA16] (IY14);
      [SA22] (IY11); [SA24] (IY22); [SA25] (IY23); [SA26] (IY24);
      [SA32] (IY11); [SA34] (IY32); [SA35] (IY33); [SA36] (IY34);

      ! Latent means freely estimated at all waves (identified by marker intercept = 0)
      [wx1@0]; [wy1@0];
      [wx2* wx3*];
      [wy2* wy3*];

  MODEL CONSTRAINT:

  0 = LX12 + LX13 + LX14 - LX22 - LX23 - LX24;
  0 = LX12 + LX13 + LX14 - LX32 - LX33 - LX34;

  0 = LY12 + LY13 + LY14 - LY22 - LY23 - LY24;
  0 = LY12 + LY13 + LY14 - LY32 - LY33 - LY34;



    OUTPUT: tech1 tech3 tech4 stdyx residual cinterval;



