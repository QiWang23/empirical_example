INPUT INSTRUCTIONS

  DATA:   FILE = application_example.dat;
    VARIABLE:
        names = ID HO11-HO14
                   HO21-HO24
                   HO31-HO34
                   SA11-SA18
                   SA21-SA28
                   SA31-SA38;

      USEVARIABLES = SA12 SA14 SA15 SA16
                     !SA22 SA24 SA25 SA26
                     !SA32 SA34 SA35 SA36
                     ;

    analysis:
    estimator = ml;
    RITERATIONS = 5000;
    !STARTS = 500;

  MODEL:
      SA1 BY SA12
             SA14  (L2)
             SA15  (L3)
             SA16  (L4);

      SA1 (V);

      SA12 (E1);        ! label the residual (error) variances
      SA14 (E2);
      SA15 (E3);
      SA16 (E4);

  MODEL CONSTRAINT:

      NEW(omega);
      omega = (1 + L2 + L3 + L4)**2 * V/
              ((1 + L2 + L3 + L4)**2 * V + (E1 + E2 + E3 + E4));





    OUTPUT: tech1 tech4 stdyx residual cinterval;



