INPUT INSTRUCTIONS

  DATA:   FILE = application_example.dat;
    VARIABLE:
        names = ID HO11-HO14
                   HO21-HO24
                   HO31-HO34
                   SA11-SA18
                   SA21-SA28
                   SA31-SA38;

      USEVARIABLES = HO11-HO14
                   !HO21-HO24
                   !HO31-HO34
                     ;

    analysis:
    estimator = ml;
    RITERATIONS = 5000;
    !STARTS = 500;

  MODEL:
      HO1 BY HO11
             HO12  (L2)
             HO13  (L3)
             HO14  (L4);
      HO1 (V);

      HO11 (E1);        ! label the residual (error) variances
      HO12 (E2);
      HO13 (E3);
      HO14 (E4);

  MODEL CONSTRAINT:

      NEW(omega);
      omega = (1 + L2 + L3 + L4)**2 * V/
              ((1 + L2 + L3 + L4)**2 * V + (E1 + E2 + E3 + E4));



    OUTPUT: tech1 tech3 stdyx residual cinterval;



