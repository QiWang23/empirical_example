          MODEL = NOCOV;

      MODEL:
          FX1 BY cx1@1;
          FX2 BY cx2@1;
          FX3 BY cx3@1;
          FY1 BY cy1@1;
          FY2 BY cy2@1;
          FY3 BY cy3@1;
          cx1@3.228441;
          cx2@3.112889;
          cx3@3.429189;
          cy1@4.920829;
          cy2@4.69457;
          cy3@4.64167;

          ! -------- Structural paths --------
          ! Wave 2
          FX2 ON FX1;
          FX2 ON FY1;
          FY2 ON FX1;
          FY2 ON FY1;

          ! Wave 3
          FX3 ON FX2;
          FX3 ON FY2;
          FY3 ON FX2;
          FY3 ON FY2;

          FX1 with FY1;
          FX2 with FY2;
          FX3 with FY3;

  output: TECH1 STDYX SAMPSTAT CINTERVAL;



